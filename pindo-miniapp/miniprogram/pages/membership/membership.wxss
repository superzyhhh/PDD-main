.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.header {
  padding: 24rpx 8rpx 32rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #7A6F66;
}

.card {
  padding: 8rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.benefit {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #F0EBE4;
}

.benefit:last-child {
  border-bottom: none;
}

.benefit-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: #2B2622;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 44rpx;
  text-align: center;
}

.benefit-text {
  margin-left: 20rpx;
  font-size: 28rpx;
  color: #2B2622;
}

.notice {
  display: block;
  margin-top: 24rpx;
  padding: 0 8rpx;
  font-size: 22rpx;
  color: #9A8F85;
}

.state {
  padding: 48rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
}

.state-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.5;
  color: #7A6F66;
}

.btn {
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #2B2622;
  color: #FFFFFF;
  font-size: 28rpx;
}

.status-card {
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #F0EBE4;
}

.status-card.active {
  border-color: #2B2622;
}

.status-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2B2622;
}

.status-detail {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7A6F66;
}

.plans {
  margin-top: 24rpx;
}

.plans-title {
  display: block;
  padding: 0 8rpx 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2B2622;
}

.plan-list {
  display: flex;
  flex-direction: row;
  gap: 20rpx;
}

.plan-card {
  flex: 1;
  padding: 28rpx 24rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 2rpx solid #F0EBE4;
}

.plan-label {
  display: block;
  font-size: 28rpx;
  color: #2B2622;
}

.plan-price {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #2B2622;
}

.plan-days {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9A8F85;
}

.plan-action {
  display: block;
  margin-top: 20rpx;
  padding: 14rpx 0;
  border-radius: 999rpx;
  background: #2B2622;
  color: #FFFFFF;
  font-size: 24rpx;
  text-align: center;
}
