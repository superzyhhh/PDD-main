<view class="page">
  <view class="header">
    <text class="title">会员权益</text>
    <text class="subtitle">开通后立即生效；到期只收回权益，已保存的图纸仍可查看</text>
  </view>

  <view class="card">
    <view class="benefit" wx:for="{{benefits}}" wx:key="*this">
      <text class="benefit-index">{{index + 1}}</text>
      <text class="benefit-text">{{item}}</text>
    </view>
  </view>

  <text class="notice">会员开通即将上线</text>
</view>
