.page {
  padding: 24rpx 24rpx 48rpx;
  box-sizing: border-box;
}

.header {
  padding: 24rpx 8rpx 32rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
}

.subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7A6F66;
}

.state {
  margin: 80rpx 0;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-text {
  font-size: 28rpx;
  line-height: 1.5;
  text-align: center;
}

.state-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9A8F85;
}

.pattern-card {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
  background: #FFFFFF;
  border: 2rpx solid #E6DED4;
  border-radius: 16rpx;
  display: flex;
  flex-direction: row;
  align-items: center;
}

.pattern-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.pattern-label {
  font-size: 28rpx;
  font-weight: 600;
}

.pattern-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #7A6F66;
}

.pattern-date {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9A8F85;
}

.pattern-actions {
  flex-shrink: 0;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.pattern-open {
  font-size: 26rpx;
  color: #2B2622;
}

.pattern-delete {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #A15C2B;
}

.btn {
  margin-top: 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: #2B2622;
  font-size: 28rpx;
}
