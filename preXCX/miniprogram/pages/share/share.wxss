.share-page {
  padding: 32rpx 32rpx 64rpx;
}

.share-head {
  margin-bottom: 24rpx;
}

.share-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.share-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7A6F66;
}

.share-image {
  width: 100%;
  border-radius: 20rpx;
  background: #FFFFFF;
}

.share-hint {
  display: block;
  margin: 20rpx 0 28rpx;
  font-size: 24rpx;
  color: #9A8F85;
  text-align: center;
}

.state {
  margin-top: 160rpx;
  padding: 48rpx 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.state-title {
  font-size: 30rpx;
  line-height: 1.5;
  text-align: center;
}

.state-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #9A8F85;
  text-align: center;
}

.btn {
  margin-top: 20rpx;
  width: 100%;
  background: #FFFFFF;
  color: #2B2622;
  border: 2rpx solid #E6DED4;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.btn.primary {
  background: #2B2622;
  color: #FFFFFF;
  border-color: #2B2622;
}

